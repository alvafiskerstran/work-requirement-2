form {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

label {
  font-weight: bold;
  color: #2b2b6b;
}

input,
textarea {
  font: inherit;
  padding: 10px;
  border: 2px solid #2b2b6b;
  border-radius: 6px;
  margin-bottom: 10px;
}

input:focus,
textarea:focus {
  outline: none;
  border-color: #c28a2c;
}

button {
  align-self: flex-start;
  font: inherit;
  padding: 10px 25px;
  background-color: #2b2b6b;
  color: #f4e9da;
  border: none;
  border-radius: 6px;
  cursor: pointer;
}

button:hover {
  background-color: #c28a2c;
}

